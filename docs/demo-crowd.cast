[41.375604, "o", "{\"premium\":\"paid for by a member of the set, and the set is all this server knows\",\"settled_by\":\"9a4ac3836685070b09edda8eda7a726ff2f5438d0c6d0cfba6915bdce6896db7\"}"]
[41.382604, "o", "\r\n\u001b[1m5. what the server knows\u001b[0m\r\n   the response above is the whole of it: a member of the set paid.\r\n   not which member. and the next payment by this same credential will\r\n"]
