# pq402 — copy to .env and fill in.

# --- x402 settlement (the payment lane) --------------------------------
STELLAR_NETWORK=stellar:testnet
X402_NETWORK=stellar:testnet
FACILITATOR_URL=https://channels.openzeppelin.com/x402/testnet

# Required on testnet as well as mainnet. Web form, no API:
#   https://channels.openzeppelin.com/testnet/gen
# Without it every facilitator endpoint answers 401.
OZ_API_KEY=

# Receives the USDC. A classic G... account, and it needs a USDC trustline.
# This is NOT the SAC address: the scheme invokes transfer on the contract,
# while this account is what ends up holding the balance.
STELLAR_RECIPIENT=

# The agent's wallet. Needs a USDC trustline and a USDC balance
# (https://faucet.circle.com, pick Stellar testnet). No XLM required: the
# facilitator sponsors network fees.
STELLAR_SECRET_KEY=

# USDC's Soroban Asset Contract on testnet. Override only for another SEP-41.
USDC_SAC=CBIELTK6YBZJU5UP2WWQEUCYKLPU6AUNZ2BQ4WWFEIE3USCIHMXQDAMA

# Price per unlock, in USDC. Stellar USDC has SEVEN decimals.
PRICE_USD=0.10

# --- post-quantum credential gate (the proof lane) ---------------------
# Built from the repaired relation: leaf and nullifier are digests, not
# full permutation states. See "Honest limits" in the README.
PQ_CONTRACT_ID=CA6QM6DRPVYRHFWEWNATDIKLL4P47XBI2OWVL7226WHHOTFEY2W2JKET
PQ_QUERIES=40
# The stellar identity that submits the on-chain credential spend, and that the
# agent signs payments with. `node setup.mjs` creates and fills this in.
PQ_SOURCE=

# 1 (default): unlock submits a real spend, so the nullifier burns in
# contract storage and single use is enforced by consensus.
# 0: read-only simulation, free, but the server becomes the replay authority.
PQ_SPEND=1

# 1 opts INTO the payment stub, for demoing the proof lane with no key and no
# funded wallet. Real settlement is the default.
MOCK_PAYMENT=0
