# pq402 — copy to .env and run `node setup.mjs`, which fills most of this in.
#
# Every variable here is read by something. Where a value is kept only for your
# records rather than consumed by the code, it says so.

# --- x402 settlement (the payment lane) --------------------------------

# Required on testnet as well as mainnet. One command:
#   curl -s https://channels.openzeppelin.com/testnet/gen   ->  {"apiKey":"..."}
# Without it every facilitator endpoint answers 401, and the server refuses to
# start rather than advertise a paywall it cannot settle.
OZ_API_KEY=

# Receives the USDC. A classic G... account, and it needs a USDC trustline.
# NOT the SAC: the scheme invokes `transfer` on the contract below, while this
# account is what ends up holding the balance. `node setup.mjs` fills it in.
STELLAR_RECIPIENT=

# The CAIP-2 network id x402 speaks, and the facilitator for it.
X402_NETWORK=stellar:testnet
FACILITATOR_URL=https://channels.openzeppelin.com/x402/testnet

# USDC's Soroban Asset Contract on testnet. Override only for another SEP-41.
USDC_SAC=CBIELTK6YBZJU5UP2WWQEUCYKLPU6AUNZ2BQ4WWFEIE3USCIHMXQDAMA

# Price per unlock, in USDC. Stellar assets carry SEVEN decimals, so this
# becomes 1000000 base units. The six an EVM habit expects would be a tenth of
# the intended price, settling quietly.
PRICE_USD=0.10

# --- post-quantum credential gate (the proof lane) ---------------------

# Built from the repaired relation: leaf and nullifier are digests, not full
# permutation states. See "Honest limits" in the README.
PQ_CONTRACT_ID=CA6QM6DRPVYRHFWEWNATDIKLL4P47XBI2OWVL7226WHHOTFEY2W2JKET
PQ_QUERIES=40

# The stellar identity that submits the credential spend, and that the agent
# signs payments with. `node setup.mjs` creates it and fills this in.
PQ_SOURCE=

# The stellar CLI's --network takes a CONFIG NAME. Deliberately not the same
# variable as X402_NETWORK above: feeding a CAIP-2 id to the CLI fails with
# "Invalid name", four frames from anything that mentions the network.
PQ_NETWORK=testnet

# 1 (default): unlock submits a real spend, so the nullifier burns in contract
#   storage and single use is enforced by consensus.
# 0: read-only simulation — free, but the server becomes the replay authority.
PQ_SPEND=1

# 1 opts INTO the payment stub, to exercise the proof lane with no facilitator
# key and no funded wallet. Real settlement is the default.
MOCK_PAYMENT=0

# --- kept for your records, read by nothing ----------------------------

# The payer's secret. `setup.mjs` writes it here so you can recover the account
# and paste its address into the Circle faucet. The agent does not read it: it
# signs through the stellar keystore under PQ_SOURCE above, which is why that
# identity has to exist.
STELLAR_SECRET_KEY=

# --- the unlinkable credential (mode: "crowd") -------------------------
# The gate that verifies a member acted and burns the nullifier. It derives the
# expected round from the ledger sequence, so the challenge is not this
# server's to choose and a stale proof is refused by consensus.
CROWD_ACT_CONTRACT=CAEZ25KZFMYAL44I342B44VYG5KVO5ESHNDQXC2Y3VSWN5XAN3OQOANO
# The verifier for "this commitment sits under the issuer's root".
CROWD_MEMBERSHIP_CONTRACT=CDO2NDPR37AEDFZJTN3MBHMS6QBDQ6Y44YCGPGRIOXHKWPX4L2JPXIWK
# The issuer's published root. `./demo-crowd.sh` mints a credential and uses
# its root, so you do not need to set this to try it.
CROWD_ROOT=
